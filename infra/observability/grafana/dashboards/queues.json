{
  "uid": "koovela-queues",
  "title": "Filas e outbox",
  "tags": [
    "koovela"
  ],
  "timezone": "America/Sao_Paulo",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Mensagens por fila",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages)",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DLQs",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{queue=~\".*\\\\.dlq\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Consumidas/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_destination_name) (rate(messaging_client_consumed_messages_total[5m]))",
          "legendFormat": "{{messaging_destination_name}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Falhas de consumidor/s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (messaging_destination_name, outcome) (rate(koovela_messaging_failures_total[5m]))",
          "legendFormat": "{{messaging_destination_name}} {{outcome}}"
        }
      ]
    }
  ]
}
