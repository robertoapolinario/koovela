{
  "name": "@koovela/design-tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/tokens.ts",
    "./tokens.css": "./dist/tokens.css",
    "./src/*": "./src/*"
  },
  "scripts": {
    "build": "node style-dictionary.config.ts",
    "prepare": "node style-dictionary.config.ts",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts' --exclude '**/*.int.test.ts' --exclude '**/e2e/**' --exclude '**/node_modules/**'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "style-dictionary": "4.4.0"
  }
}
