{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_signatures"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": true,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "lint · tipos · unidade · arquitetura · env"
          },
          {
            "context": "integração (Testcontainers)"
          },
          {
            "context": "segredos · dependências"
          },
          {
            "context": "acessibilidade (axe, AA)"
          },
          {
            "context": "build linux/arm64 (sem publicar) + Trivy (gateway)"
          },
          {
            "context": "build linux/arm64 (sem publicar) + Trivy (core)"
          },
          {
            "context": "build linux/arm64 (sem publicar) + Trivy (workers)"
          },
          {
            "context": "build linux/arm64 (sem publicar) + Trivy (consumer-web)"
          },
          {
            "context": "build linux/arm64 (sem publicar) + Trivy (tenant-web)"
          },
          {
            "context": "build linux/arm64 (sem publicar) + Trivy (admin-web)"
          },
          {
            "context": "LCP < 2,5 s em 4G (páginas públicas)"
          },
          {
            "context": "contrato de provedor (Schemathesis × gateway)"
          }
        ]
      }
    }
  ]
}
