{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koovela.com/schemas/release.v1.json",
  "title": "release.json (data-model §1.1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "commit", "built_at", "images", "sbom", "signature"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d{2}-[0-9a-f]{7}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "built_at": { "type": "string", "format": "date-time" },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["service", "image", "digest", "platform"],
        "properties": {
          "service": { "enum": ["gateway", "core", "workers", "consumer-web", "tenant-web", "admin-web", "bi-placeholder"] },
          "image": { "type": "string", "pattern": "^ghcr\\.io/[a-z0-9._/-]+$" },
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "platform": { "const": "linux/arm64" }
        }
      }
    },
    "sbom": { "type": "string", "format": "uri", "pattern": "^https://" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "identity"],
      "properties": {
        "issuer": { "const": "https://token.actions.githubusercontent.com" },
        "identity": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+/\\.github/workflows/deliver\\.yml@refs/heads/main$" }
      }
    }
  }
}
