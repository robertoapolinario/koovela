{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.koovela.com/schemas/rbac-permissions.v1.json",
  "title": "Matriz de permissões da Koovela (packages/contracts/rbac/permissions.yaml)",
  "description": "Fonte única do RBAC (REQ-IDN-050). Gera can() e um teste por célula (REQ-IDN-051). Derivada da DF 7.",
  "type": "object",
  "required": ["version", "roles", "actions"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "roles": {
      "type": "array",
      "items": { "enum": ["consumer", "professional", "receptionist", "manager", "owner", "support", "finance_ops", "growth", "sre"] },
      "uniqueItems": true
    },
    "grantable": {
      "description": "Permissões que o Proprietário concede ou retira por Gerente",
      "type": "array",
      "items": { "type": "string" }
    },
    "actions": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z_]+(\\.[a-z_]+)+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["scope", "cells"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "spec": { "type": "string", "pattern": "^[0-9]{3}$", "description": "Spec dona da ação" },
          "scope": { "enum": ["public", "self", "branch", "network", "platform"] },
          "sensitive": { "type": "boolean", "description": "Exige reautenticação ≤ 5 min (REQ-IDN-022)" },
          "audit": { "type": "boolean", "description": "Gera registro de ação privilegiada" },
          "pending": { "type": "string", "pattern": "^PEN-[0-9]{2}$" },
          "cells": {
            "type": "object",
            "description": "Papel → regra. Papel ausente = deny.",
            "additionalProperties": {
              "oneOf": [
                { "enum": ["allow", "deny", "allow_scoped", "allow_in_support_session"] },
                {
                  "type": "object",
                  "required": ["allow_if_granted"],
                  "properties": { "allow_if_granted": { "type": "string" } },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "version": 1,
      "roles": ["consumer", "professional", "receptionist", "manager", "owner", "support", "finance_ops", "growth", "sre"],
      "grantable": ["manager.billing.view", "manager.loyalty.configure", "manager.care_note.read"],
      "actions": {
        "team.invite": { "spec": "003", "scope": "network", "sensitive": true, "audit": true, "cells": { "owner": "allow" } },
        "billing.branch_revenue.view": { "spec": "018", "scope": "branch", "cells": { "owner": "allow", "manager": { "allow_if_granted": "manager.billing.view" }, "finance_ops": "allow" } },
        "care_note.read": { "spec": "020", "scope": "self", "audit": true, "cells": { "professional": "allow_scoped", "owner": "allow", "manager": { "allow_if_granted": "manager.care_note.read" }, "receptionist": "deny", "support": "deny", "sre": "deny" } },
        "support_session.open": { "spec": "003", "scope": "platform", "audit": true, "cells": { "support": "allow", "sre": "allow" } },
        "appointment.create": { "spec": "009", "scope": "branch", "cells": { "receptionist": "allow_scoped", "manager": "allow_scoped", "owner": "allow", "support": "allow_in_support_session" } }
      }
    }
  ]
}
