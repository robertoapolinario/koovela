{
  "name": "koovela",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module",
  "scripts": {
    "koovela": "node tools/koovela-cli/src/cli.ts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "spec:lint": "node tools/spec-lint/src/cli.ts",
    "env:check": "node tools/env-check/src/check.ts",
    "env:generate": "node tools/env-check/src/generate.ts",
    "secrets:scan": "sh tools/dev/secrets-scan.sh",
    "arch:check": "depcruise --config .dependency-cruiser.cjs --exclude \"__tests__/fixtures\" services runtimes packages",
    "contracts:generate": "turbo run generate --filter=@koovela/sdk",
    "contracts:breaking": "node tools/contracts-check/src/breaking.ts",
    "format": "prettier --write .",
    "branch:check": "node tools/branch-check/src/cli.ts",
    "bundle": "node tools/build/bundle.ts",
    "ops:edge-scan": "node tools/edge-scan/src/cli.ts",
    "test:pii": "vitest run packages/platform/logger",
    "ops:pii-sweep": "node tools/ops/src/pii-sweep.ts",
    "ops:restore-test": "node tools/ops/src/restore-test.ts",
    "test:a11y": "turbo run test:a11y",
    "pin:check": "node tools/pin-check/src/cli.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "dependency-cruiser": "18.9.0",
    "lefthook": "2.2.4",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3",
    "vitest": "5.1.2",
    "@types/node": "24.19.4",
    "@koovela/eslint-config": "workspace:*",
    "eslint": "9.39.5",
    "fast-check": "4.11.0",
    "esbuild": "0.28.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@koovela/design-tokens",
      "esbuild",
      "lefthook"
    ]
  }
}
