# Gerado por `pnpm env:generate` a partir de packages/platform/config. Não edite à mão.

# --- process ---
# Ambiente em execução
KOOVELA_ENV=local
# Processo implantável (D44)
KOOVELA_PROCESS=core
# Domínios carregados pelo processo, separados por vírgula
KOOVELA_DOMAINS=platform
# Versão de release em execução (AAAA.MM.DD-sha7)
KOOVELA_VERSION=0.0.0-local
# Nível de log
LOG_LEVEL=info
# Porta HTTP do processo
HTTP_PORT=8080
# --- database ---
# Host do MySQL
MYSQL_HOST=mysql
# Porta do MySQL
MYSQL_PORT=3306
# Usuário administrativo usado só pelo executor de migrações
MYSQL_MIGRATOR_USER=root
# Senha do usuário de migrações (secreto)
MYSQL_MIGRATOR_PASSWORD=
# --- queue_cache ---
# URL do RabbitMQ (secreto)
RABBITMQ_URL=
# URL do Redis (secreto)
REDIS_URL=
# --- observability ---
# Endpoint OTLP do OpenTelemetry Collector (vazio desliga a exportação)
OTEL_EXPORTER_OTLP_ENDPOINT=
# DSN do Sentry (opcional) (secreto)
SENTRY_DSN=
# --- edge ---
# Endereço interno do processo core (o gateway verifica a saúde dele)
CORE_URL=http://core:8080
# Requisições por janela e por IP no gateway (rate limit fino, além da regra da Cloudflare)
RATE_LIMIT_MAX=300
# Janela do rate limit do gateway, em segundos
RATE_LIMIT_WINDOW_SECONDS=60
# --- observability ---
# Token do webhook do Alertmanager para o registro de incidentes (core) (secreto)
ALERTMANAGER_WEBHOOK_TOKEN=
# --- edge ---
# Origens canônicas aceitas pelo CORS do gateway, separadas por vírgula
CORS_ALLOWED_ORIGINS=http://koovela.localhost,http://app.koovela.localhost,http://painel.koovela.localhost,http://admin.koovela.localhost
# --- database (credencial por domínio, REQ-FND-028) ---
MYSQL_USER_PLATFORM=koovela_platform
MYSQL_PASSWORD_PLATFORM=
MYSQL_USER_GATEWAY=koovela_gateway
MYSQL_PASSWORD_GATEWAY=
